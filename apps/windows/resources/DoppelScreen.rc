#include <windows.h>

1 ICON "AppIcon.ico"
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "sharkpp.net"
      VALUE "FileDescription", "DoppelScreen Windows Host"
      VALUE "FileVersion", "0.1.0"
      VALUE "InternalName", "DoppelScreen"
      VALUE "OriginalFilename", "DoppelScreen.exe"
      VALUE "ProductName", "DoppelScreen"
      VALUE "ProductVersion", "0.1.0"
    END
  END
END
